# Local development (docker compose reads this file; so do the API and Vite).
# Copy to .env. Apart from the LocalStack token, the defaults run without any accounts.

# ── AWS / S3 (supplier documents) ──
# Local S3 is LocalStack. Free account at https://app.localstack.cloud → Auth Token. Required to start it.
LOCALSTACK_AUTH_TOKEN=
# Host port for LocalStack. If another project's LocalStack already uses 4566, pick another
# (e.g. 4567) and use it in the two localhost URLs below too.
LOCALSTACK_PORT=4566
DOCUMENTS_BUCKET=lacey-factory-documents-local
# Host-side scripts (npm run worker / simulate outside docker) reach LocalStack on localhost.
# Containers use http://localstack:4566 from docker-compose.yml; bucket, region and keys come from here.
AWS_ENDPOINT_URL=http://localhost:4566
# Host the browser uses for "View document" links.
AWS_PUBLIC_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-2

# ── Temporal ──
# Host-side runs reach the compose dev server on localhost; containers use temporal:7233.
# Temporal Cloud: <namespace>.<account>.tmprl.cloud:7233 plus TEMPORAL_API_KEY.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lacey-factory
TEMPORAL_API_KEY=

# ── Local sign-in bypass ──
# The API acts as this user (only under NODE_ENV=development). Set empty to use Auth0.
DEV_AUTH_EMAIL=eric@lakemat.com
# The web app skips Auth0. Set to false to use Auth0.
VITE_DEV_AUTH=true

# ── Auth0 (only when the bypass is off): the staging tenant. VITE_AUTH0_CLIENT_ID is
# `terraform output -raw auth0_client_id` in the terraform repo's staging workspace. ──
# API: verifies access tokens.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://factory.lakemat.com/api
# Web: the "Lacey Factory" Single Page Application.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://factory.lakemat.com/api

# Extra emails allowed besides @lakemat.com (comma separated). Keep in sync
# with allowed_emails in the terraform repo's staging.tfvars (the Auth0 action's list).
ALLOWED_EMAILS=

# Running the API outside docker (npm run dev -w api) against the compose DB:
# DATABASE_URL=postgres://factory:factory@localhost:5432/factory

# ── Supplier emails → invoices (Temporal worker) ──
# "fake": emails come from `docker compose exec api npm run simulate -- hanes`.
# "live": read eric@lakemat.com through the Gmail API (needs the Google settings below).
GMAIL_MODE=fake
# Reads invoices with Claude. Without it, documents go to the Inbox for review.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# Encrypts stored Google refresh tokens: openssl rand -base64 32
EMAIL_TOKEN_KEY=

# Google Cloud (lakemat.com Workspace) — only for GMAIL_MODE=live. See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/api/email/callback
GMAIL_PUBSUB_TOPIC=
# Local live Gmail: pull notifications (no public URL needed).
# PUBSUB_MODE=pull
# GMAIL_PUBSUB_SUBSCRIPTION=projects/<project>/subscriptions/gmail-factory-local
# Folder (outside the repo) holding the Pub/Sub service-account key; docker compose
# mounts it into the api container. Defaults: ~/.config/lacey-factory/pubsub-sa.json
# GOOGLE_CREDENTIALS_DIR=/Users/you/.config/lacey-factory
# GOOGLE_CREDENTIALS_FILE=pubsub-sa.json
# If your org blocks service-account keys, use your gcloud login instead
# (gcloud auth application-default login):
# GOOGLE_CREDENTIALS_DIR=/Users/you/.config/gcloud
# GOOGLE_CREDENTIALS_FILE=application_default_credentials.json

# Amazon Seller orders (US + Canada). Paid orders become sales that take steel and fabric.
# off | fake (orders from `docker compose exec api npm run simulate:amazon -- us`) | sandbox | live
AMAZON_MODE=off
# From Solution Provider Portal → your app (sandbox and production have different credentials).
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
# From "Create Token" (self-authorization) on the app.
AMAZON_REFRESH_TOKEN=
# US, Canada
AMAZON_MARKETPLACE_IDS=ATVPDKIKX0DER,A2EUQ1WTGCTBG2
# First sync reads orders from here (default: 30 days back).
# AMAZON_SYNC_START=2026-11-01
# AMAZON_SYNC_EVERY=15m

# Shopify orders (US store, which also sells to Canada). Paid orders arrive by webhook and become
# sales; "Pull orders" on the Orders page fills gaps.
# off | fake (orders from `docker compose exec api npm run simulate:shopify -- mi`) | live
SHOPIFY_MODE=off
SHOPIFY_SHOP=lakemat-2.myshopify.com
# From the app in the Shopify Dev Dashboard (scopes: read_orders, read_customers, read_all_orders,
# plus protected customer data access for name, email, phone and address). The secret also signs
# webhooks; in fake mode any value works.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# SHOPIFY_API_VERSION=2026-01
# Live only: the worker subscribes this URL to orders/paid, orders/updated and orders/cancelled.
# SHOPIFY_WEBHOOK_URL=https://factory.lakemat.com/api/webhooks/shopify
# "Pull orders" with no date starts here the first time (default: 30 days back).
# SHOPIFY_PULL_START=2026-01-01

# ShipStation (API V2): each label's cost and ship date, attached to its Shopify or Amazon order.
# off | fake (labels from `docker compose exec api npm run simulate:shipstation -- latest`) | live
SHIPSTATION_MODE=off
# Settings → Account → API Settings in ShipStation (one key, V2).
SHIPSTATION_API_KEY=
# Live only: the worker subscribes this URL to label_created_v2 and fulfillment_shipped_v2.
# ShipStation allows one URL per event per account, so only one environment can receive them.
# SHIPSTATION_WEBHOOK_URL=https://factory.lakemat.com/api/webhooks/shipstation

# Low-stock Slack alerts (worker). A Slack Incoming Webhook URL; empty = alerts are only logged.
SLACK_WEBHOOK_URL=
