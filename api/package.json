{
  "name": "@lacey-factory/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx src/worker.ts",
    "worker:dev": "tsx watch --include src/temporal src/worker.ts",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:amazon": "tsx scripts/simulate-amazon.ts",
    "simulate:shopify": "tsx scripts/simulate-shopify.ts",
    "read-document": "tsx scripts/read-document.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@google-cloud/pubsub": "^6.3.2",
    "@hono/node-server": "^2.1.6",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.3",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@temporalio/testing": "^1.25.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
