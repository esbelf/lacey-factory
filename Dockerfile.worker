# Production Temporal worker (ECS Fargate). Build from the repo root:
#   docker build -f Dockerfile.worker -t lacey-factory-worker .
# Config comes from the task's environment / Secrets Manager (see README).
FROM node:24-bookworm-slim
# Root certificates: Temporal's native client reads the system store for TLS to
# Temporal Cloud, and the slim image has none (NativeCertsNotFound).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production NPM_CONFIG_UPDATE_NOTIFIER=false
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY api/package.json api/
COPY web/package.json web/
# Dev dependencies included: the worker runs TypeScript through tsx, and
# Temporal bundles the workflow code from source at startup.
RUN npm ci --workspace api --workspace shared --include-workspace-root=false --include=dev
COPY shared shared
COPY api api
WORKDIR /app/api
USER node
CMD ["npx", "tsx", "src/worker.ts"]
