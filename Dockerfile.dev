# Local development image shared by the api and web services in
# docker-compose.yml. Source is bind-mounted; node_modules live in the image
# (Linux builds of native deps like esbuild), not on the host.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY api/package.json api/
COPY web/package.json web/
RUN npm ci
