# Only for running scripts/deploy.sh from a laptop: copy to deploy/staging.env or
# deploy/production.env (git-ignored). GitHub Actions gets the same names as
# GitHub Environment variables instead.
# Values: `terraform output github_vars` in ../terraform-lacey-factory, plus Auth0.
AWS_REGION=us-east-2
WEB_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
LAMBDA_FUNCTION_NAME=
ECR_REPOSITORY_URL=
ECS_CLUSTER=
ECS_SERVICE=worker
APP_SECRETS_ARN=
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://factory.lakemat.com/api
